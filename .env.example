# --- Polygon / Polymarket wallet ---
POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_FUNDER_ADDRESS=your_wallet_address_on_polygon

# --- Polymarket endpoints (rarely need to change) ---
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# --- News providers ---
# NEWSFILTER is OPTIONAL. Leave blank to disable the WebSocket source.
NEWSFILTER_API_KEY=
NEWSAPI_KEY=your_newsapi_key
# Free key: https://open-platform.theguardian.com/access/   (12,000/day)
GUARDIAN_API_KEY=
# Free key: https://www.marketaux.com/account/dashboard     (100/day)
MARKETAUX_API_KEY=
# Reddit polling (no key required). Comma-separated subreddits.
REDDIT_SUBREDDITS=worldnews,news,politics,Economics,business
REDDIT_USER_AGENT=NewsTraderBot/1.0
# GDELT polling (no key required). Free-form Lucene query.
GDELT_QUERY=(politics OR election OR war OR ceasefire OR fed OR inflation OR "central bank" OR sanctions)

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Safety / Mode ---
DRY_RUN=true

# --- Capital and risk limits (USDC) ---
TOTAL_CAPITAL_USDC=1000.0
MAX_SINGLE_BET_USDC=150.0
MAX_TOTAL_OPEN_USDC=600.0
MAX_DAILY_LOSS_USDC=300.0
MAX_TRADES_PER_HOUR=6
SAFETY_MODE_CONSECUTIVE_LOSSES=3
SAFETY_MODE_PAUSE_HOURS=4

# --- Trade quality thresholds ---
MIN_MARKET_VOLUME_24H=10000.0
MIN_CONFIDENCE=0.72
MIN_EDGE_AFTER_FEES=0.07
MAX_SPREAD_CENTS=0.08
NEWS_STALENESS_MAX_MINUTES=4

# --- Cadences ---
MARKET_SCANNER_REFRESH_SECONDS=300
POSITION_MONITOR_INTERVAL_SECONDS=600
HEARTBEAT_INTERVAL_SECONDS=5
ORDER_FILL_TIMEOUT_SECONDS=90

# --- Claude call gating ---
# Anthropic Tier 1 (free) is ~5 RPM for Opus. Set this conservatively.
MAX_CLAUDE_CALLS_PER_MINUTE=4
# Pre-filter articles by keyword overlap with active market questions.
RELEVANCE_FILTER_ENABLED=true
# Cap markets included in each Claude prompt (lower = cheaper).
MAX_MARKETS_IN_PROMPT=80

# --- Misc ---
ARTICLE_BODY_MAX_WORDS=800
LOG_DB_PATH=newstrader.db
